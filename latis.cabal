cabal-version: 3.16
name: latis
version: 0.1.0.0
build-type: Simple
license: BSD-3-Clause

library
  hs-source-dirs: src
  exposed-modules:
    Latent.Grid Latent.Object Latent.Encode Latent.Render Latent.Correspondence
    Language.Types Language.ML Language.DSA Language.Effect Language.Schema Language.Witness
    Synthesis.Residual Synthesis.Dependency Synthesis.Skeleton Synthesis.Hole
    Synthesis.Search Synthesis.Verify Synthesis.MDL Synthesis.Abstraction
    Synthesis.FeaturePipeline
    Synthesis.Triggered
    Synthesis.Collection ARC.CollectionEvaluate
    Synthesis.Collection.Indexed Synthesis.Collection.Counterfactual Synthesis.Collection.Online
    Synthesis.Collection.Front ARC.CollectionV6Evaluate
    ARC.CollectionV61Generate ARC.CollectionV61Evaluate
    ARC.ArcTrainOnly
    Synthesis.Collection.Typed Synthesis.Collection.Size ARC.StageAEvaluate
    Synthesis.Collection.Referent ARC.StageBEvaluate
    Synthesis.Collection.Shape Synthesis.Collection.Relation ARC.StageCEvaluate
    Synthesis.Collection.Parameter
    Synthesis.Collection.Unified Synthesis.Collection.Diagnostics ARC.StageDEvaluate ARC.StageDMechanism
    Synthesis.Collection.ContentFirst ARC.ContentFirstEvaluate ARC.ContentFirstMechanism
    Synthesis.Collection.Geometry.Cover Synthesis.Collection.Geometry.View Synthesis.Collection.Geometry.Features ARC.GeometryMechanism
    Synthesis.Collection.Region.ShapeMDL Synthesis.Collection.Region.MDLCache Synthesis.Collection.Region.Scene Synthesis.Collection.Region.Partition Synthesis.Collection.Region.Program Synthesis.Collection.Region.Search ARC.RegionMechanism
    Synthesis.Collection.Output.Template Synthesis.Collection.Output.Scene Synthesis.Collection.Output.Induce ARC.OutputMechanism
    ARC.TraceIO
    Synthesis.Triggered.Parallel
    ARC.TriggeredEvaluate ARC.TriggeredStress
    ARC.Dataset ARC.Evaluate ARC.JointEvaluate
    Synthesis.Expression.FreeVars Synthesis.Expression.Domain
    Synthesis.Constraint.State Synthesis.Constraint.Metrics Synthesis.Constraint.Propagate
    Synthesis.Search.Memo Synthesis.Joint
    Latent.Local.Grammar Latent.Local.Encode Latent.Local.Decode Latent.Local.Discover
    Latent.Global.Grammar Latent.Global.Encode Latent.Global.Decode Latent.Global.Discover
    Latent.Fusion.Context Latent.Program Latent.Constraint.Propagate Latent.MDL.LatentCost
    Synthesis.Hierarchical
    Latent.Serialize
    ARC.LatentStress ARC.FailureTaxonomy ARC.HierarchicalEvaluate
    Language.Induced.Base
    Synthesis.Induced.Specification Synthesis.Induced.Observers Synthesis.Induced.Witness
    Synthesis.Induced.VersionSpace Synthesis.Induced.Abstraction Synthesis.Induced.Learn
    ARC.InducedEvaluate
    Synthesis.InducedR1.Specification Synthesis.InducedR1.Observers Synthesis.InducedR1.Witness
    Synthesis.InducedR1.Coverage Synthesis.InducedR1.Abstraction Synthesis.InducedR1.Learn
    ARC.InducedR1Evaluate
    Synthesis.InducedR2.Diversity Synthesis.InducedR2.Sharing Synthesis.InducedR2.Observers
    Synthesis.InducedR2.NormalForm
    Synthesis.InducedR2.PortfolioCover
    Synthesis.InducedR2.AliasSharing
    Synthesis.InducedR2.EffectDomain
    Synthesis.InducedR2.Witness Synthesis.InducedR2.Coverage Synthesis.InducedR2.VersionSpace
    Synthesis.InducedR2.Learn Synthesis.InducedR2.Counterfactual ARC.InducedR2Evaluate
  build-depends: base >=4.18 && <5, containers, time, directory, filepath, deepseq, stm
  default-language: GHC2021
  ghc-options: -Wall -O2

executable latis
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: base, latis, containers, time, directory, filepath
  default-language: GHC2021
  -- -threaded is required for --workers N to run on several OS threads;
  -- the capability count is still chosen at run time with +RTS -N<k>.
  ghc-options: -Wall -O2 -threaded -rtsopts

test-suite latis-tests
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends: base, latis, containers, directory
  default-language: GHC2021
